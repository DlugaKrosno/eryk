{
  "name": "jira-alert-management",
  "version": "3.0.0",
  "description": "Zarządzanie alertami w Jira Cloud: domeny, zespoły z dyżurami, automatyczny priorytet i powiadomienia Microsoft Teams",
  "main": "src/index.js",
  "author": "drEryk",
  "license": "MIT",
  "scripts": {
    "build": "cd static/smart && npm install --legacy-peer-deps && npm run build",
    "deploy": "forge deploy",
    "deploy:prod": "forge deploy --environment production",
    "lint": "forge lint",
    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "@atlaskit/css-reset": "^7.3.9",
    "@forge/api": "^3.0.0",
    "@forge/resolver": "^1.5.0",
    "@forge/kvs": "^2.1.0"
  },
  "devDependencies": {
    "@forge/cli": "^12.0.0"
  },
  "keywords": [
    "forge",
    "jira",
    "alert",
    "incident",
    "management",
    "escalation",
    "teams",
    "automation",
    "priority",
    "sla"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
